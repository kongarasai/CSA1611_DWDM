marks <- c(55,60,71,63,55,65,50,55,58,59,61,63,65,67,71,72,75)

# (a) Equal-Frequency Partitioning

sorted_marks <- sort(marks)
bins <- split(sorted_marks, ceiling(seq_along(sorted_marks)/6))
print("Equal-Frequency Bins:")
print(bins)

hist(marks, main="Equal-Frequency Marks Histogram",
xlab="Marks", col="lightblue")

# (b) Equal-Width Partitioning

width <- (max(marks)-min(marks))/3
breaks <- seq(min(marks), max(marks), length.out=4)

print("Equal-Width Bins:")
print(cut(marks, breaks=breaks, include.lowest=TRUE))

hist(marks, breaks=breaks, main="Equal-Width Marks Histogram",
xlab="Marks", col="lightgreen")
